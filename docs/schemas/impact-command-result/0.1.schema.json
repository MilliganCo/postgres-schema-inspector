{
  "$defs": {
    "AffectedObjectRef": {
      "additionalProperties": false,
      "description": "`schema_` is the Python attribute; the wire/alias name is `schema`\n(matches design section 4.3) since `schema` shadows a deprecated\n`pydantic.BaseModel` attribute.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "impact_role": {
          "$ref": "#/$defs/ImpactRole"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "object_kind": {
          "$ref": "#/$defs/ObjectKind"
        },
        "parent_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Identity"
        },
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema"
        }
      },
      "required": [
        "object_kind",
        "identity",
        "schema",
        "name",
        "parent_identity",
        "impact_role",
        "detail"
      ],
      "title": "AffectedObjectRef",
      "type": "object"
    },
    "AnalysisStage": {
      "enum": [
        "connect",
        "preflight",
        "parse",
        "resolve",
        "catalog",
        "rules",
        "complete"
      ],
      "title": "AnalysisStage",
      "type": "string"
    },
    "AnalysisStatus": {
      "enum": [
        "analyzed",
        "unsupported_parser",
        "unsupported_resolution",
        "unsupported_scope",
        "unsupported_evidence",
        "unsupported_sequence"
      ],
      "title": "AnalysisStatus",
      "type": "string"
    },
    "ClassificationSource": {
      "enum": [
        "connection_timeout_type",
        "sqlstate",
        "needs_password",
        "audited_tls_signal",
        "fallback_other",
        "internal"
      ],
      "title": "ClassificationSource",
      "type": "string"
    },
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low",
        "not_applicable"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "DebugFrame": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "title": "Function",
          "type": "string"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "module": {
          "title": "Module",
          "type": "string"
        }
      },
      "required": [
        "module",
        "function",
        "line"
      ],
      "title": "DebugFrame",
      "type": "object"
    },
    "DebugPayload": {
      "additionalProperties": false,
      "properties": {
        "causal_chain_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Causal Chain Types",
          "type": "array"
        },
        "exception_type": {
          "title": "Exception Type",
          "type": "string"
        },
        "frames": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DebugFrame"
          },
          "title": "Frames",
          "type": "array"
        }
      },
      "required": [
        "exception_type"
      ],
      "title": "DebugPayload",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "server_fact",
        "catalog_object",
        "dependency_edge",
        "metric_observation",
        "semantic_rule"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "ExecutionError": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ExecutionErrorCategory"
        },
        "classification_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassificationSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "code": {
          "$ref": "#/$defs/ExecutionErrorCode"
        },
        "debug": {
          "anyOf": [
            {
              "$ref": "#/$defs/DebugPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "sqlstate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqlstate"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable"
      ],
      "title": "ExecutionError",
      "type": "object"
    },
    "ExecutionErrorCategory": {
      "enum": [
        "connection",
        "session",
        "operational",
        "internal"
      ],
      "title": "ExecutionErrorCategory",
      "type": "string"
    },
    "ExecutionErrorCode": {
      "enum": [
        "authentication_failed",
        "network_unreachable",
        "connect_timeout",
        "tls_failed",
        "database_missing",
        "connection_failed",
        "operational_failure",
        "internal_failure"
      ],
      "title": "ExecutionErrorCode",
      "type": "string"
    },
    "ExecutionPrediction": {
      "enum": [
        "applies",
        "no_op",
        "would_fail",
        "may_fail",
        "not_evaluated"
      ],
      "title": "ExecutionPrediction",
      "type": "string"
    },
    "ImpactConfidence": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "execution": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "impact_scale": {
          "$ref": "#/$defs/ImpactScaleConfidence"
        },
        "lock": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "rewrite": {
          "$ref": "#/$defs/ConfidenceLevel"
        }
      },
      "required": [
        "lock",
        "rewrite",
        "execution",
        "dependencies",
        "impact_scale"
      ],
      "title": "ImpactConfidence",
      "type": "object"
    },
    "ImpactConnectionContext": {
      "additionalProperties": false,
      "properties": {
        "client_encoding": {
          "title": "Client Encoding",
          "type": "string"
        },
        "current_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Schema"
        },
        "database": {
          "title": "Database",
          "type": "string"
        },
        "in_recovery": {
          "title": "In Recovery",
          "type": "boolean"
        },
        "max_identifier_length": {
          "title": "Max Identifier Length",
          "type": "integer"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "search_path_raw": {
          "title": "Search Path Raw",
          "type": "string"
        },
        "server_encoding": {
          "title": "Server Encoding",
          "type": "string"
        },
        "server_major": {
          "title": "Server Major",
          "type": "integer"
        },
        "server_version": {
          "title": "Server Version",
          "type": "string"
        },
        "server_version_num": {
          "title": "Server Version Num",
          "type": "integer"
        },
        "session_user": {
          "title": "Session User",
          "type": "string"
        },
        "standard_conforming_strings": {
          "title": "Standard Conforming Strings",
          "type": "string"
        },
        "transaction_isolation": {
          "title": "Transaction Isolation",
          "type": "string"
        },
        "transaction_read_only": {
          "title": "Transaction Read Only",
          "type": "string"
        }
      },
      "required": [
        "server_version",
        "server_version_num",
        "server_major",
        "database",
        "role",
        "session_user",
        "current_schema",
        "search_path_raw",
        "standard_conforming_strings",
        "server_encoding",
        "client_encoding",
        "transaction_isolation",
        "transaction_read_only",
        "in_recovery",
        "max_identifier_length"
      ],
      "title": "ImpactConnectionContext",
      "type": "object"
    },
    "ImpactEvidence": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "summary"
      ],
      "title": "ImpactEvidence",
      "type": "object"
    },
    "ImpactInputMeta": {
      "additionalProperties": false,
      "properties": {
        "card_count": {
          "minimum": 0,
          "title": "Card Count",
          "type": "integer"
        },
        "control_statement_count": {
          "minimum": 0,
          "title": "Control Statement Count",
          "type": "integer"
        },
        "path_basename": {
          "title": "Path Basename",
          "type": "string"
        },
        "source_statement_count": {
          "minimum": 0,
          "title": "Source Statement Count",
          "type": "integer"
        }
      },
      "required": [
        "path_basename",
        "source_statement_count",
        "card_count",
        "control_statement_count"
      ],
      "title": "ImpactInputMeta",
      "type": "object"
    },
    "ImpactPreflight": {
      "additionalProperties": false,
      "properties": {
        "analysis_stage_reached": {
          "$ref": "#/$defs/AnalysisStage"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ImpactPreflightCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/PreflightStatus"
        }
      },
      "required": [
        "status",
        "analysis_stage_reached"
      ],
      "title": "ImpactPreflight",
      "type": "object"
    },
    "ImpactPreflightCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ImpactPreflightCheckStatus"
        }
      },
      "required": [
        "id",
        "status",
        "detail"
      ],
      "title": "ImpactPreflightCheck",
      "type": "object"
    },
    "ImpactPreflightCheckStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped"
      ],
      "title": "ImpactPreflightCheckStatus",
      "type": "string"
    },
    "ImpactRole": {
      "enum": [
        "target",
        "internal",
        "automatic",
        "blocker",
        "cascade",
        "rebuilt",
        "related"
      ],
      "title": "ImpactRole",
      "type": "string"
    },
    "ImpactScaleConfidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown",
        "not_applicable"
      ],
      "title": "ImpactScaleConfidence",
      "type": "string"
    },
    "ImpactSnapshot": {
      "additionalProperties": false,
      "properties": {
        "catalog_snapshot_at": {
          "format": "date-time",
          "title": "Catalog Snapshot At",
          "type": "string"
        },
        "metrics_consistency": {
          "const": "best_effort",
          "title": "Metrics Consistency",
          "type": "string"
        },
        "metrics_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metrics Observed At"
        },
        "server_version_num": {
          "title": "Server Version Num",
          "type": "integer"
        }
      },
      "required": [
        "catalog_snapshot_at",
        "metrics_observed_at",
        "metrics_consistency",
        "server_version_num"
      ],
      "title": "ImpactSnapshot",
      "type": "object"
    },
    "ImpactStatementCard": {
      "additionalProperties": false,
      "properties": {
        "affected_objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffectedObjectRef"
          },
          "title": "Affected Objects",
          "type": "array"
        },
        "analysis_status": {
          "$ref": "#/$defs/AnalysisStatus"
        },
        "confidence": {
          "$ref": "#/$defs/ImpactConfidence"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "execution_prediction": {
          "$ref": "#/$defs/ExecutionPrediction"
        },
        "index_rebuild": {
          "$ref": "#/$defs/PhysicalTriState"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "lock": {
          "$ref": "#/$defs/LockMode"
        },
        "no_op_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoOpReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "safer_rollout": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaferRollout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sanitized_preview": {
          "title": "Sanitized Preview",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "statement_fingerprint": {
          "title": "Statement Fingerprint",
          "type": "string"
        },
        "statement_index": {
          "title": "Statement Index",
          "type": "integer"
        },
        "table_rewrite": {
          "$ref": "#/$defs/PhysicalTriState"
        },
        "table_scan": {
          "$ref": "#/$defs/PhysicalTriState"
        },
        "why": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Why",
          "type": "array"
        }
      },
      "required": [
        "statement_index",
        "start_line",
        "end_line",
        "statement_fingerprint",
        "sanitized_preview",
        "analysis_status",
        "execution_prediction",
        "no_op_reason",
        "risk",
        "confidence",
        "lock",
        "table_rewrite",
        "table_scan",
        "index_rebuild"
      ],
      "title": "ImpactStatementCard",
      "type": "object"
    },
    "ImpactSummary": {
      "additionalProperties": false,
      "properties": {
        "analyzed_count": {
          "minimum": 0,
          "title": "Analyzed Count",
          "type": "integer"
        },
        "critical_count": {
          "minimum": 0,
          "title": "Critical Count",
          "type": "integer"
        },
        "incomplete": {
          "title": "Incomplete",
          "type": "boolean"
        },
        "may_fail_count": {
          "minimum": 0,
          "title": "May Fail Count",
          "type": "integer"
        },
        "no_op_count": {
          "minimum": 0,
          "title": "No Op Count",
          "type": "integer"
        },
        "not_applicable_count": {
          "minimum": 0,
          "title": "Not Applicable Count",
          "type": "integer"
        },
        "overall_risk": {
          "$ref": "#/$defs/Risk"
        },
        "safe_count": {
          "minimum": 0,
          "title": "Safe Count",
          "type": "integer"
        },
        "unsupported_count": {
          "minimum": 0,
          "title": "Unsupported Count",
          "type": "integer"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        },
        "would_fail_count": {
          "minimum": 0,
          "title": "Would Fail Count",
          "type": "integer"
        }
      },
      "required": [
        "overall_risk",
        "critical_count",
        "warning_count",
        "safe_count",
        "not_applicable_count",
        "would_fail_count",
        "may_fail_count",
        "unsupported_count",
        "no_op_count",
        "analyzed_count",
        "incomplete"
      ],
      "title": "ImpactSummary",
      "type": "object"
    },
    "LockMode": {
      "enum": [
        "AccessExclusiveLock",
        "ShareUpdateExclusiveLock",
        "not_applicable",
        "unknown"
      ],
      "title": "LockMode",
      "type": "string"
    },
    "NoOpReason": {
      "enum": [
        "target_missing_if_exists",
        "column_missing_if_exists",
        "column_already_exists_if_not_exists"
      ],
      "title": "NoOpReason",
      "type": "string"
    },
    "ObjectKind": {
      "enum": [
        "table",
        "column",
        "index",
        "constraint",
        "view",
        "function",
        "type",
        "collation",
        "other"
      ],
      "title": "ObjectKind",
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "completed",
        "incomplete",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "PhysicalTriState": {
      "enum": [
        "yes",
        "no",
        "possible",
        "unknown",
        "not_applicable"
      ],
      "title": "PhysicalTriState",
      "type": "string"
    },
    "PreflightStatus": {
      "enum": [
        "passed",
        "incomplete",
        "failed"
      ],
      "title": "PreflightStatus",
      "type": "string"
    },
    "Risk": {
      "enum": [
        "critical",
        "warning",
        "safe",
        "not_applicable"
      ],
      "title": "Risk",
      "type": "string"
    },
    "SaferRollout": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "preconditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "steps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "title": "SaferRollout",
      "type": "object"
    }
  },
  "$id": "urn:pginspect:schema:impact-command-result:0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "app_version": {
      "title": "App Version",
      "type": "string"
    },
    "command": {
      "const": "impact",
      "default": "impact",
      "title": "Command",
      "type": "string"
    },
    "connection_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImpactConnectionContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionError"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ImpactEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        5
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "input": {
      "$ref": "#/$defs/ImpactInputMeta"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "preflight": {
      "$ref": "#/$defs/ImpactPreflight"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImpactSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "statements": {
      "items": {
        "$ref": "#/$defs/ImpactStatementCard"
      },
      "title": "Statements",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/ImpactSummary"
    }
  },
  "required": [
    "outcome",
    "exit_code",
    "started_at",
    "duration_ms",
    "app_version",
    "input",
    "connection_context",
    "preflight",
    "snapshot",
    "summary",
    "statements",
    "evidence",
    "error"
  ],
  "title": "ImpactCommandResult",
  "type": "object"
}
