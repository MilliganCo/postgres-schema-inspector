        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ConnectionFindingScope"
        },
        "severity": {
          "const": "ok",
          "default": "ok",
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "const": "passed",
          "default": "passed",
          "title": "Status",
          "type": "string"
