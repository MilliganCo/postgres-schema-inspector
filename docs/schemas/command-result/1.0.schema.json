        "server_major_label": {
          "title": "Server Major Label",
          "type": "string"
        },
        "server_version": {
          "title": "Server Version",
          "type": "string"
        },
        "server_version_num": {
          "title": "Server Version Num",
          "type": "integer"
        },
        "session_user": {
          "title": "Session User",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ConnectionTargetContext"
        },
        "version_support": {
          "$ref": "#/$defs/VersionSupportStatus"
        }
      },
      "required": [
        "database",
        "role",
        "session_user",
        "server_version",
        "server_version_num",
        "server_major",
        "server_major_label",
        "version_support",
        "in_recovery",
        "target",
        "privileges",
        "extensions"
      ],
