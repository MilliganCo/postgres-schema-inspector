{
  "$defs": {
    "ClassificationSource": {
      "enum": [
        "connection_timeout_type",
        "sqlstate",
        "needs_password",
        "audited_tls_signal",
        "fallback_other",
        "internal"
      ],
      "title": "ClassificationSource",
      "type": "string"
    },
    "CommandExitCode": {
      "enum": [
        0,
        1,
        2,
        3,
        5
      ],
      "title": "CommandExitCode",
      "type": "integer"
    },
    "CommandOutcome": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "CommandOutcome",
      "type": "string"
    },
    "ConnectTestCommandResult": {
      "additionalProperties": false,
      "properties": {
        "app_version": {
          "title": "App Version",
          "type": "string"
        },
        "command": {
          "const": "connect-test",
          "default": "connect-test",
          "title": "Command",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectionContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionError"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "$ref": "#/$defs/CommandExitCode"
        },
        "findings": {
          "items": {
            "discriminator": {
              "mapping": {
                "connection.established": "#/$defs/ConnectionEstablishedFinding",
                "connection.failed": "#/$defs/ConnectionFailedFinding",
                "connection.server_version_experimental": "#/$defs/ServerVersionExperimentalFinding",
                "connection.server_version_supported": "#/$defs/ServerVersionSupportedFinding",
                "connection.server_version_unsupported": "#/$defs/ServerVersionUnsupportedFinding",
                "connection.server_version_untested": "#/$defs/ServerVersionUntestedFinding",
                "connection.session_safety_misconfigured": "#/$defs/SessionSafetyMisconfiguredFinding",
                "connection.session_safety_verified": "#/$defs/SessionSafetyVerifiedFinding"
              },
              "propertyName": "id"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConnectionEstablishedFinding"
              },
              {
                "$ref": "#/$defs/ConnectionFailedFinding"
              },
              {
                "$ref": "#/$defs/ServerVersionSupportedFinding"
              },
              {
                "$ref": "#/$defs/ServerVersionExperimentalFinding"
              },
              {
                "$ref": "#/$defs/ServerVersionUntestedFinding"
              },
              {
                "$ref": "#/$defs/ServerVersionUnsupportedFinding"
              },
              {
                "$ref": "#/$defs/SessionSafetyVerifiedFinding"
              },
              {
                "$ref": "#/$defs/SessionSafetyMisconfiguredFinding"
              }
            ]
          },
          "title": "Findings",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/CommandOutcome"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "duration_ms",
        "app_version",
        "outcome",
        "exit_code",
        "context",
        "findings",
        "error"
      ],
      "title": "ConnectTestCommandResult",
      "type": "object"
    },
    "ConnectionContext": {
      "additionalProperties": false,
      "properties": {
        "database": {
          "title": "Database",
          "type": "string"
